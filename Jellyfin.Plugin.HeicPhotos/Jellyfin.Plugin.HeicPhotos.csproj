<Project Sdk="Microsoft.NET.Sdk">

  <!-- HEIC Photos: iPhone photos (HEIC/HEIF) in Jellyfin's photo libraries, converted with the
       server's own ffmpeg when they're shown. Built against the Jellyfin release it runs on. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Jellyfin.Plugin.HeicPhotos</AssemblyName>
    <RootNamespace>Jellyfin.Plugin.HeicPhotos</RootNamespace>
    <Version>0.2.0.0</Version>
    <AssemblyVersion>0.2.0.0</AssemblyVersion>
    <FileVersion>0.2.0.0</FileVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- MetadataExtractor ships beside the plugin's own dll. -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <JellyfinVersion Condition="'$(JellyfinVersion)' == ''">12.4.0</JellyfinVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="MetadataExtractor" Version="2.9.0" />
  </ItemGroup>

</Project>
